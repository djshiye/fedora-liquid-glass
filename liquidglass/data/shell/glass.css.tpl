#dash .dash-item-container .show-apps .overview-icon,
#dash .dash-item-container .overview-tile .overview-icon {
  color: ${fg};
  background-color: transparent; }
#dash .dash-item-container .show-apps:hover .overview-icon,
#dash .dash-item-container .overview-tile:hover .overview-icon {
  background-color: ${hover}; }
#dash .dash-separator {
  background-color: ${divider}; }
.workspace-thumbnails .workspace-thumbnail {
  border-radius: ${r_small}px;
  border: 1px solid ${edge};
  background-color: ${card}; }
.workspace-thumbnail-indicator {
  border-color: ${accent};
  border-radius: ${r_small}px; }
.page-indicator, .page-indicator-icon {
  background-color: ${fg_faint}; }
.dash-label, .window-caption, .screenshot-ui-tooltip {
  color: ${fg};
  background-color: ${osd};
  border: 1px solid ${edge};
  border-top-color: ${rim};
  border-radius: 999px;
  box-shadow: 0 4px 14px 0 ${shadow}; }
.window-caption {
  border-radius: ${r_item}px; }
.select-area-rubberband {
  background-color: ${selection};
  border-color: ${accent}; }

/* ---------------------------------------------------------------- lock and login */
.unlock-dialog .login-dialog-prompt-entry, .login-dialog-prompt-entry, .login-dialog .login-dialog-prompt-entry {
  color: ${fg};
  background-color: ${field};
  border: 1px solid ${edge};
  border-radius: 999px; }

/* ---------------------------------------------------------------- Wheelguard popup */
/* @boost */
.popup-menu-content.wg-menu {
  padding: 0;
  background-color: ${popover};
  border: 1px solid ${edge};
  border-top-color: ${rim};
  border-radius: ${r_menu}px;
  box-shadow: 0 10px 30px 0 ${shadow}; }
.popup-menu-content.wg-menu.wg-light {
  background-color: ${popover};
  border: 1px solid ${edge};
  border-top-color: ${rim};
  box-shadow: 0 10px 30px 0 ${shadow}; }
.wg-root, .wg-light .wg-root {
  color: ${fg}; }
.wg-title, .wg-card-title, .wg-percent, .wg-pill-label, .wg-chip,
.wg-light .wg-title, .wg-light .wg-card-title, .wg-light .wg-percent, .wg-light .wg-pill-label, .wg-light .wg-chip {
  color: ${fg}; }
.wg-card-sub, .wg-note, .wg-icon-btn-icon, .wg-light .wg-card-sub, .wg-light .wg-note, .wg-light .wg-icon-btn-icon {
  color: ${fg_dim}; }
.wg-percent.wg-faint, .wg-light .wg-percent.wg-faint {
  color: ${fg_faint}; }
.wg-note.wg-good, .wg-light .wg-note.wg-good {
  color: ${success}; }
.wg-dpi-active, .wg-light .wg-dpi-active {
  color: ${accent_text}; }
.wg-card, .wg-light .wg-card {
  background-color: ${card};
  border: 1px solid ${edge};
  border-top-color: ${rim};
  border-radius: ${r}px; }
.wg-seg, .wg-light .wg-seg {
  background-color: ${field};
  border: 1px solid ${edge};
  border-radius: 999px; }
.wg-chip {
  border-radius: 999px; }
.wg-pill {
  border-radius: 999px; }
.wg-home:hover, .wg-home:focus, .wg-icon-btn:hover, .wg-icon-btn:focus, .wg-chip:hover,
.wg-light .wg-home:hover, .wg-light .wg-home:focus, .wg-light .wg-icon-btn:hover,
.wg-light .wg-icon-btn:focus, .wg-light .wg-chip:hover {
  background-color: ${hover}; }
.wg-icon-btn:active, .wg-light .wg-icon-btn:active {
  background-color: ${active}; }
.wg-switch, .wg-light .wg-switch {
  background-color: ${switch_off};
  border: 1px solid ${edge}; }
.wg-switch:focus {
  border-color: ${accent_edge}; }
.wg-switch.wg-on, .wg-light .wg-switch.wg-on, .wg-chip.wg-chip-active, .wg-light .wg-chip.wg-chip-active,
.wg-start, .wg-light .wg-start {
  background-gradient-direction: vertical;
  background-gradient-start: ${acc_top};
  background-gradient-end: ${acc_bot}; }
.wg-start:hover {
  background-gradient-start: ${acc_hover_top};
  background-gradient-end: ${acc_hover_bot}; }
.wg-chip.wg-chip-active, .wg-light .wg-chip.wg-chip-active, .wg-start-label {
  color: ${accent_fg}; }
.wg-start {
  border-radius: 999px; }
.wg-chip:focus {
  box-shadow: inset 0 0 0 2px ${focus_ring}; }

/* @end */

/* ---------------------------------------------------------------- ArcMenu (surfaces; its own theme options colour the rest) */
.arcmenu-menu .popup-menu-content {
  border-top-color: ${rim};
  box-shadow: 0 10px 30px 0 ${shadow}; }
.arcmenu-tooltip, #ArcMenu_Tooltip {
  color: ${fg};
  background-color: ${osd};
  border: 1px solid ${edge};
  border-top-color: ${rim};
  border-radius: ${r_item}px;
  box-shadow: 0 4px 14px 0 ${shadow}; }
.arcmenu-text-indicator {
  background-color: ${hover}; }
.arcmenu-indicator {
  color: ${accent_text}; }
