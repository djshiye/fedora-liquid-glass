  background-color: ${field_hover};
  border-color: ${accent_edge};
  box-shadow: inset 0 0 0 2px ${focus_ring} !important; }
StEntry StLabel.hint-text {
  color: ${fg_faint}; }
.lg-dialog StEntry {
  background-color: ${field}; }

/* ---------------------------------------------------------------- switches, sliders, scrollbars */
.toggle-switch {
  border: 1px solid ${edge};
  background: ${switch_off}; }
.toggle-switch:hover {
  background: ${switch_off_hover}; }
.toggle-switch .handle {
  background: #ffffff;
  box-shadow: 0 2px 5px 0 ${shadow}; }
.toggle-switch:checked {
  border-color: ${accent_edge};
  background: ${accent}; }
.toggle-switch:checked:hover {
  background: ${acc_hover_top}; }
.slider {
  color: ${fg};
  -barlevel-height: 6px;
  -barlevel-background-color: ${track};
  -barlevel-active-background-color: ${accent};
  -barlevel-overdrive-color: ${destructive};
  -slider-handle-radius: 0.6em; }
.slider:hover {
  color: ${fg}; }
.check-box StBin, .check-box:focus StBin {
  border-color: ${fg_faint}; }
StScrollBar > .vhandle, StScrollBar > .hhandle {
  background-color: ${scroll}; }
StScrollBar > .vhandle:hover, StScrollBar > .hhandle:hover {
  background-color: ${scroll_hover}; }

/* ---------------------------------------------------------------- top bar */
#panel {
  background-color: ${chrome};
  box-shadow: inset 0 1px 0 0 ${rim};
  font-weight: 600;
  color: ${fg}; }
#panel .panel-button {
  color: ${fg};
  border-width: 2px;
  font-weight: 600;
  box-shadow: inset 0 0 0 100px transparent; }
#panel .panel-button:focus, #panel .panel-button:hover {
  color: ${fg};
  box-shadow: inset 0 0 0 100px ${hover}; }
#panel .panel-button:active, #panel .panel-button:checked {
  color: ${fg};
  box-shadow: inset 0 0 0 100px ${active}; }
#panel .panel-button:active:hover, #panel .panel-button:checked:hover {
  box-shadow: inset 0 0 0 100px ${active}; }
#panel .panel-button.clock-display .clock {
  border-width: 2px; }
#panel .panel-button.clock-display:focus .clock, #panel .panel-button.clock-display:hover .clock {
  box-shadow: inset 0 0 0 100px ${hover}; }
#panel .panel-button.clock-display:active .clock, #panel .panel-button.clock-display:checked .clock {
  box-shadow: inset 0 0 0 100px ${active}; }
#panel .panel-button#panelActivities .workspace-dot {
  background-color: ${fg}; }
#panel:overview {
  background-color: transparent;
  box-shadow: none; }

/* @boost: extension stylesheets load after the theme, so these need the extra id to win */
/* ---- Dash to Panel */
