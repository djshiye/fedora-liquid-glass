/* Liquid Glass for GNOME Shell. Generated by Liquid Glass, do not edit.
   St cannot blur: the glass behind these surfaces comes from the Liquid Glass extension.
   St draws one box-shadow only, so the lit top edge is an inset shadow on small
   controls and a lighter border-top on large surfaces (leaving the shadow for depth). */
@import url("resource:///org/gnome/shell/theme/gnome-shell-${variant}.css");

stage {
  -st-accent-color: ${accent};
  -st-accent-fg-color: ${accent_fg};
  color: ${fg}; }

/* ---------------------------------------------------------------- shared controls */
.button, .icon-button, .message-notification-group .message-collapse-button,
.calendar .calendar-month-header .pager-button {
  color: ${fg};
  border: 1px solid ${edge};
  border-radius: 999px;
  box-shadow: inset 0 1px 0 0 ${rim};
  background-gradient-direction: vertical;
  background-gradient-start: ${ctrl_top};
  background-gradient-end: ${ctrl_bot}; }
.button:hover, .icon-button:hover, .message-notification-group .message-collapse-button:hover,
.calendar .calendar-month-header .pager-button:hover {
  color: ${fg};
  background-gradient-start: ${ctrl_hover_top};
  background-gradient-end: ${ctrl_hover_bot}; }
.button:active, .icon-button:active, .button:checked, .icon-button:checked,
.message-notification-group .message-collapse-button:active,
.calendar .calendar-month-header .pager-button:active {
  color: ${fg};
  background-gradient-start: ${ctrl_press_top};
  background-gradient-end: ${ctrl_press_bot}; }
.button:insensitive, .icon-button:insensitive {
  color: ${fg_faint};
  background-gradient-start: ${ctrl_bot};
  background-gradient-end: ${ctrl_bot}; }
.button:focus, .icon-button:focus {
  color: ${fg}; }
.button.flat, .icon-button.flat {
  border-color: transparent;
  box-shadow: none;
  background-gradient-direction: none;
  background-color: transparent; }
.button.flat:hover, .icon-button.flat:hover {
  background-color: ${hover}; }
.button.flat:active, .icon-button.flat:active, .button.flat:checked, .icon-button.flat:checked {
  background-color: ${active}; }
.button.default, .icon-button.default, .button:checked.default {
  color: ${accent_fg};
  border-color: ${accent_edge};
  background-gradient-start: ${acc_top};
  background-gradient-end: ${acc_bot}; }
.button.default:hover, .icon-button.default:hover {
  color: ${accent_fg};
  background-gradient-start: ${acc_hover_top};
  background-gradient-end: ${acc_hover_bot}; }
.button.default:active, .icon-button.default:active {
  color: ${accent_fg};
  background-gradient-start: ${acc_press_top};
  background-gradient-end: ${acc_press_bot}; }

/* Pills inside message cards and notification actions */
.notification-button, .message .message-header .message-expand-button,
.message .message-header .message-close-button {
  color: ${fg};
  border: 1px solid ${edge};
  border-radius: 999px;
  box-shadow: inset 0 1px 0 0 ${rim};
  background-gradient-direction: vertical;
  background-gradient-start: ${ctrl_top};
  background-gradient-end: ${ctrl_bot}; }
.notification-button:hover, .message .message-header .message-expand-button:hover,
.message .message-header .message-close-button:hover {
