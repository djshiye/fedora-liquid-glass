  background-gradient-end: ${ctrl_press_bot}; }

StEntry {
  color: ${fg_dim};
  background-color: ${field};
  border: 1px solid ${edge};
  border-radius: 999px;
  box-shadow: inset 0 1px 2px 0 ${field_shadow}; }
StEntry:hover {
  color: ${fg};
  background-color: ${field_hover}; }
StEntry:focus {
